[internationalization]

locale/fallback="ru"

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Interactable"
3d_physics/layer_4="Creature"
3d_physics/layer_5="Trigger"
3d_physics/layer_6="GameplayNoise"

[mcp_toolkit]

status="No .mcp.json found — use Project > Tools > MCP Toolkit > Write .mcp.json to create one."

[rendering]

environment/volumetric_fog/volume_size=48
environment/volumetric_fog/volume_depth=24
environment/defaults/default_clear_color=Color(0.011, 0.016, 0.014, 1)

