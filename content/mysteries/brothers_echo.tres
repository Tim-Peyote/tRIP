[resource]
script = ExtResource("1")
id = &"mystery.brothers_echo"
display_name = "Эхо двух братьев"
description = "Корневая полость отвечает двумя одинаковыми голосами, но только один делает паузы для дыхания."
discovery_text = "На живом голосе растёт малая шляпка. Финальная формула должна удержать два ритма, не превращая один в копию другого."
