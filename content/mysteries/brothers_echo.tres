[gd_resource type="Resource" script_class="WorldMysteryDefinition" load_steps=2 format=3]
[ext_resource type="Script" path="res://core/resources/world_mystery_definition.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"mystery.brothers_echo"
display_name = "Эхо двух братьев"
description = "Корневая полость отвечает двумя одинаковыми голосами, но только один делает паузы для дыхания."
discovery_text = "На живом голосе растёт малая шляпка. Финальная формула должна удержать два ритма, не превращая один в копию другого."
recipe_hint_id = &"recipe.final_concordance"
ingredient_hint_id = &"ingredient.concordance_cap"
event_rule = 1
event_instruction = "Пригнись у корня и слушай паузы: настоящий голос вынужден дышать."
failure_text = "Ложный голос повторил твоё движение и снова стал неотличим от живого."
event_duration = 5.2
danger_radius = 6.5
pressure_rate = 0.42
event_color = Color(0.9, 0.28, 0.72, 1)
audio_pitch = 0.64
