[ext_resource type="Script" path="res://core/resources/world_mystery_definition.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"mystery.camp_erasure"
display_name = "Стоянка, стёртая дважды"
description = "Колышки остаются, но ткань, зола и следы исчезают при прямом взгляде."
discovery_text = "Под золой лежит камыш с отражением другой стоянки. Брат предупреждает: в котёл кладут стебель, а не его убедительную тень."
recipe_hint_id = &"recipe.mirror_reed_broth"
ingredient_hint_id = &"ingredient.mirror_reed"
