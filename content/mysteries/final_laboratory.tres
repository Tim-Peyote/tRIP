[gd_resource type="Resource" script_class="WorldMysteryDefinition" load_steps=2 format=3]
[ext_resource type="Script" path="res://core/resources/world_mystery_definition.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"mystery.final_laboratory"
display_name = "Лаборатория, которая помнит"
description = "На плато стоит версия дорожного лагеря, собранная из предметов обоих братьев."
discovery_text = "Поиск завершён не ответом, а выбором: вывести брата из общего сна, оставить Сердце нетронутым или повторить цикл с другим составом."
event_rule = 0
event_instruction = "Останься между двумя рабочими местами. Не выбирай голос, пока они не разойдутся сами."
failure_text = "Сердце приняло поспешное движение за выбор и снова смешало две памяти."
event_duration = 6.0
danger_radius = 9.0
pressure_rate = 0.48
event_color = Color(1, 0.22, 0.74, 1)
audio_pitch = 0.92
