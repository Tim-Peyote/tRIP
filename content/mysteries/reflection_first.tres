ingredient_hint_id = &"ingredient.deep_root"
event_rule = 4
event_instruction = "Медленно приблизься к воде и остановись там, где отражение совпадёт с телом."
failure_text = "Отражение пришло слишком рано и заняло твоё место у корня."
