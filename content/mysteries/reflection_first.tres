[resource]
script = ExtResource("1")
id = &"mystery.reflection_arrives_first"
display_name = "Отражение приходит первым"
description = "Вода показывает игрока у корня за несколько секунд до его приближения."
discovery_text = "Два среза одного корня не совпадают. Их нужно соединить в вязкую массу, чтобы выбрать единственную версию глубины."
