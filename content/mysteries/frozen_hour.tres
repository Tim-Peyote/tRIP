[gd_resource type="Resource" script_class="WorldMysteryDefinition" load_steps=2 format=3]
[ext_resource type="Script" path="res://core/resources/world_mystery_definition.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"mystery.frozen_hour"
display_name = "Замёрзший час"
description = "В ледяном архиве один и тот же след сохранён в пяти стадиях движения."
discovery_text = "Последний след указывает на сухой цветок. Его готовность нельзя увидеть — нужно дождаться, когда звон уйдёт в воду."
recipe_hint_id = &"recipe.ashen_bell_tea"
ingredient_hint_id = &"ingredient.ashen_bell"
event_rule = 0
event_instruction = "Не двигайся между ледяными плитами, пока сохранённый час проходит сквозь тебя."
failure_text = "Лёд записал лишнее движение и вернул час к первой пластине."
event_duration = 5.0
danger_radius = 6.5
pressure_rate = 0.34
event_color = Color(0.42, 0.88, 1, 1)
audio_pitch = 1.52
