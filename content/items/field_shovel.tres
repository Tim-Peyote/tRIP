[gd_resource type="Resource" script_class="ToolDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/resources/tool_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"tool.field_shovel"
