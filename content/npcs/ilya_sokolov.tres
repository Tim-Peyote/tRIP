[gd_resource type="Resource" script_class="NPCArchetypeDefinition" load_steps=2 format=3]
[ext_resource type="Script" path="res://core/resources/npc_archetype_definition.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"npc.ilya_sokolov"
display_name = "Илья Соколов"
description = "Пропавший брат героя, полевой миколог и автор опасной методики согласованных настоев."
tags = Array[StringName]([&"story", &"brother", &"mycologist"])
world_phase_ids = Array[StringName]([&"phase.mycelial_choir", &"phase.root_dream", &"phase.distant_heart"])
encounter_role = 4
persistence = 0
affiliation = &"katun_field_institute"
occupation = "Миколог-эколог; картировал взаимосвязи грибницы, пожаров, копытных и влажности почвы."
public_goal = "Найти формулу, позволяющую наблюдать память мицелия без разрушения экосистемы."
private_need = "Доказать, что он не повторяет научную карьеру отца и способен остановиться сам."
secret = "Он не просто потерялся: намеренно разорвал обратную последовательность рецепта, чтобы Сердце не вышло за пределы долины."
relationship_keys = Array[StringName]([&"player_brother", &"vera_colleague", &"arseniy_source"])
silhouette_notes = "Высокий сутулый силуэт, полевая куртка на размер больше, защитные очки на лбу, красный гермомешок как дальний цветовой якорь."
clothing_layers = "Термобельё → шерстяная рубашка → выцветшая полевая куртка → разгрузочный ремень; одежда постепенно обрастает метками разных миров."
carried_gear = Array[String](["складная лупа", "нож для образцов", "диктофон", "гермомешок", "самодельный споровый фильтр"])
palette = PackedColorArray(0.12, 0.16, 0.12, 1, 0.37, 0.44, 0.28, 1, 0.72, 0.12, 0.07, 1)
expression_states = Array[StringName]([&"focused", &"sleep_deprived", &"defensive", &"relieved", &"terrified_calm"])
animation_states = Array[StringName]([&"write_knee", &"inspect_sample", &"listen_ground", &"argue", &"prepare_formula", &"phase_split"])
personality_traits = Array[String](["наблюдательный", "самоуверенный", "нежный к живому", "скрывает страх шуткой"])
dialogue_themes = Array[String](["цена знания", "братская конкуренция", "где заканчивается наблюдение и начинается внушение"])
encounter_rules = "До Корневого сна появляется только в записях, звуковых остатках и несовпадающих отражениях. Телесная встреча никогда не подтверждается одной сенсорной системой."
lore_note = "Илья — источник научной ошибки и человеческой ставки, а не избранный шаман."
