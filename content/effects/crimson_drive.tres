[gd_resource type="Resource" script_class="EffectDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/resources/effect_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"effect.crimson_drive"
display_name = "Багряный гон"
description = "Лес становится системой горячих следов, но след игрока также делается ярче."
tags = Array[StringName]([&"perception", &"world_phase", &"predatory"])
duration_seconds = 78.0
cancels_effect_ids = Array[StringName]([&"effect.spore_sight", &"effect.spore_quiet"])
gameplay_channels = {&"crimson_drive": 1.0, &"creature_attraction": 0.72, &"toxicity": 0.28}
presentation_channels = {&"perception": 0.58, &"toxicity": 0.3, &"danger": 0.72}
opportunity = "Проявляет горячие следы зверей и хищные проходы Багряного гона."
price = "Шум и запах игрока распространяются дальше; слушатели быстрее переходят в погоню."
tell = "Пульс становится слышен снаружи, а холодные формы проваливаются в чёрное."
counterplay = "Тлеющий контрагент гасит пик и возвращает лес к Яви."
world_reaction = "Деревья вытягиваются в рога, камни краснеют, а ложные звериные тропы начинают двигаться."
