gameplay_tells = Array[String](["Живой голос имеет дыхание между повторами", "Чужая фраза указывает на существовавшую стоянку"])
player_interactions = Array[StringName]([&"observe", &"offer_shiny", &"follow"])
world_layer_mutation = "В Сердце повторяет голоса из нескольких вариантов одного забега."
lore_note = "Персонажи спорят, действительно ли ворон запомнил речь или препарат заставляет игрока достраивать шум."
