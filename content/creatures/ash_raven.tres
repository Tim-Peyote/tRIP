diet_tags = Array[StringName]([&"omnivore", &"carrion"])
natural_basis = "Основа — реальный ворон; способность воспроизводить целые звуковые сцены является вымышленным эффектом Пепельной тишины."
silhouette_notes = "Крупный чёрный врановый, клиновидный хвост, тяжёлый клюв; края перьев распадаются на пепельные частицы."
