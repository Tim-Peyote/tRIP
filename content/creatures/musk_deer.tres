move_speed = 3.8
awareness_distance = 20.0
flee_distance = 13.0
habitat_tags = Array[StringName]([&"dark_taiga", &"rocky_slope"])
diet_tags = Array[StringName]([&"lichen", &"moss"])
natural_basis = "Реальная кабарга Южной Сибири; редкая, одиночная и скрытная. Клыки не превращают её в хищника."
silhouette_notes = "Короткое тело, очень длинные задние ноги, покатая спина, у самца заметны тонкие верхние клыки; рогов нет."
body_color = Color(0.23, 0.18, 0.13, 1)
accent_color = Color(0.67, 0.63, 0.5, 1)
