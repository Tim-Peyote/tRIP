behavior_traits = Array[String](["Замирает в тени валуна", "Прыгает вверх по склону", "Не собирается в стадо"])
gameplay_tells = Array[String](["Два тихих удара копыт", "В Хоре её следы складываются в пунктирную фразу"])
player_interactions = Array[StringName]([&"observe", &"track"])
world_layer_mutation = "В Мицелиальном хоре останавливается одновременно со вдохом грибницы и указывает безопасный ритм."
lore_note = "В записях брата кабарга названа «живым метрономом»: она первой слышит общий вдох."
