[ext_resource type="PackedScene" path="res://assets/third_party/quaternius_animated_animals/Deer.fbx" id="2_deer"]
[resource]
script = ExtResource("1")
id = &"creature.musk_deer"
display_name = "Кабарга"
description = "Небольшой таёжный олень без рогов, исчезающий среди камней."
tags = Array[StringName]([&"fauna", &"ungulate", &"rare"])
world_phase_ids = Array[StringName]([&"phase.ordinary", &"phase.mycelial_choir"])
