[gd_resource type="Resource" script_class="RecipeDefinition" load_steps=7 format=3]
[ext_resource type="Script" path="res://core/resources/recipe_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/resources/recipe_step_definition.gd" id="2"]
[sub_resource type="Resource" id="wash"]
script = ExtResource("2")
operation = &"wash"
minimum_amount = 0.95
maximum_amount = 1.05
minimum_temperature = 12.0
maximum_temperature = 20.0
minimum_duration = 4.0
maximum_duration = 6.0
player_hint = "Смыть чужие споры холодной водой, не касаясь пластинок пальцами."
[sub_resource type="Resource" id="slice"]
script = ExtResource("2")
operation = &"slice"
minimum_amount = 0.95
maximum_amount = 1.05
minimum_temperature = 14.0
maximum_temperature = 25.0
minimum_duration = 6.0
maximum_duration = 8.0
player_hint = "Разделить шляпку между двумя пульсами; обе половины должны продолжать сокращаться независимо."
[sub_resource type="Resource" id="grind"]
script = ExtResource("2")
operation = &"grind"
ingredient_tag = &"part_whole"
minimum_amount = 0.95
maximum_amount = 1.05
minimum_temperature = 14.0
maximum_temperature = 25.0
minimum_duration = 9.0
maximum_duration = 13.0
player_hint = "Растирать в ритме второго пульса, не подстраивая его под свой."
[sub_resource type="Resource" id="heat"]
script = ExtResource("2")
operation = &"heat"
ingredient_tag = &"heart_resonance"
minimum_amount = 0.95
maximum_amount = 1.05
minimum_temperature = 79.0
maximum_temperature = 83.0
minimum_duration = 30.0
maximum_duration = 36.0
minimum_stirs = 5
minimum_homogeneity = 0.9
maximum_overheat_duration = 1.0
player_hint = "Пять оборотов, затем не касаться котла до совпадения двух волн пара."
[resource]
script = ExtResource("1")
id = &"recipe.final_concordance"
display_name = "Формула согласия"
description = "Переход из Корневого сна в Сердце Дальнего леса."
tags = Array[StringName]([&"brew", &"world_key", &"heart", &"final"])
primary_ingredient_id = &"ingredient.concordance_cap"
steps = Array[ExtResource("2")]([SubResource("wash"), SubResource("slice"), SubResource("grind"), SubResource("heat")])
result_item_id = &"item.final_concordance"
effect_ids = Array[StringName]([&"effect.heart_resonance"])
acceptable_error = 0.1
field_notes = "Формула не терпит имитации: состав должен удерживать два независимых ритма."
