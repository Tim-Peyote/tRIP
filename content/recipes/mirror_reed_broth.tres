[resource]
script = ExtResource("1")
id = &"recipe.mirror_reed_broth"
display_name = "Зеркальный отвар"
description = "Переход из Пепельной тишины в Зеркальный разлив."
tags = Array[StringName]([&"brew", &"world_key", &"mirror"])
primary_ingredient_id = &"ingredient.mirror_reed"
